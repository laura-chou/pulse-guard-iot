{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!.*\\.php$).*)",
      "destination": "/api/$1.php"
    },
    {
      "source": "/((?!dashboard/).*)",
      "destination": "/dashboard/$1"
    }
  ],
  "ignoreCommand": "if [[ \"$VERCEL_GIT_COMMIT_REF\" == \"main\" ]]; then exit 1; else exit 0; fi"
}
