# PulseGuard Backend Configuration Example
# Copy this file to .env and fill in the actual values

# ---------------------------------------------------------
# MQTT Settings (Dynamic Routing)
# ---------------------------------------------------------
# MQTT_BROKERS_CONFIG: JSON string mapping logical broker names to connection details.
# If the broker does not require authentication, simply omit the "user" and "password" fields.
# The example below demonstrates "DEFAULT" (no auth) and "HOSPITAL_A" (with auth).
MQTT_BROKERS_CONFIG='{"DEFAULT": {"host": "your_public_broker", "port": 1883}, "HOSPITAL_A": {"host": "10.0.0.5", "port": 8883, "user": "admin", "password": "pw"}}'

# The global topic pattern for all brokers
MQTT_TOPIC_PATTERN=pulseguard/+/+/data

# ---------------------------------------------------------
# MongoDB Settings (Lazy Connection Pool)
# ---------------------------------------------------------
# MONGO_DB_CONFIG: JSON string mapping device IDs to MongoDB connection details.
# A "DEFAULT" key is strictly mandatory as a fallback for any unregistered devices.
MONGO_DB_CONFIG='{"DEFAULT": {"uri": "mongodb://localhost:27017", "db_name": "pulseguard", "col_name": "health_data"}, "DEVICE_001": {"uri": "mongodb://remote-mongo:27017", "db_name": "hospital_a", "col_name": "device_001_data"}}'

# ---------------------------------------------------------
# LINE Messaging API Settings (Dynamic Routing)
# ---------------------------------------------------------
# LINE_BOT_TOKENS/USERS: JSON strings mapping specific device IDs to LINE credentials.
# If a device is NOT explicitly listed here, the system will silently skip sending LINE notifications.
LINE_BOT_TOKENS='{"DEVICE_001": "token_for_device_001", "DEVICE_002": "token_for_device_002"}'
LINE_TARGET_USERS='{"DEVICE_001": "user_id_for_device_001", "DEVICE_002": "user_id_for_device_002"}'ㄋ