# PulseGuard Backend Configuration Example
# Copy this file to .env and fill in the actual values

# MQTT Settings (Dynamic Routing)
# MQTT_BROKERS_CONFIG: JSON string mapping logical broker names to connection details.
MQTT_BROKERS_CONFIG={"DEFAULT": {"host": "your_mqtt_broker_endpoint", "port": 8883, "user": "your_mqtt_username", "password": "your_mqtt_password"}}
MQTT_TOPIC_PATTERN=pulseguard/+/+/data

# MongoDB Settings (Lazy Connection Pool)
# MONGO_DB_CONFIG: JSON string mapping device IDs to MongoDB connection details. "DEFAULT" is mandatory.
MONGO_DB_CONFIG={"DEFAULT": {"uri": "mongodb://localhost:27017", "db_name": "pulseguard", "col_name": "health_data"}, "OLED_001": {"uri": "mongodb://remote-mongo:27017", "db_name": "hospital_a", "col_name": "device_001_data"}}

# LINE Messaging API Settings (Dynamic Routing)
# LINE_BOT_TOKENS/USERS: JSON strings mapping device IDs to LINE credentials.
LINE_BOT_TOKENS={"DEFAULT": "your_default_line_token", "OLED_001": "token_for_oled_001"}
LINE_TARGET_USERS={"DEFAULT": "your_default_line_user_id", "OLED_001": "user_id_for_oled_001"}
